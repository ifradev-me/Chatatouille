{
  "name": "bot-test",
  "version": "1.2.0",
  "description": "Modular multi-platform bot (WhatsApp/Telegram/Discord) with plugin system",
  "type": "module",
  "main": "dist/core/index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-manifests.mjs",
    "start": "node --enable-source-maps dist/core/index.js",
    "dev": "tsx watch core/index.ts",
    "typecheck": "tsc --noEmit",
    "sim:conversation": "node scripts/sim-conversation.mjs"
  },
  "dependencies": {
    "@cacheable/node-cache": "^1.0.0",
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^7.0.0-rc11",
    "dotenv": "^16.4.5",
    "glob": "^11.0.0",
    "grammy": "^1.43.0",
    "pg": "^8.21.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "qrcode-terminal": "^0.12.0",
    "string-comparison": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.0",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
