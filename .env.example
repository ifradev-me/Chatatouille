# Platform
WA_SESSION_PATH=./sessions/wa
WA_USE_PAIRING_CODE=false
WA_PHONE_NUMBER=
TELEGRAM_TOKEN=
DISCORD_TOKEN=

# Enable/disable platforms
ENABLE_WHATSAPP=true
ENABLE_TELEGRAM=false
ENABLE_DISCORD=false

# Database — PostgreSQL connection string
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# Migrations dijalankan otomatis saat boot (lihat core/db/migrations/).
DATABASE_URL=postgres://bot:bot@localhost:5432/bot

# LLM / n8n
N8N_WEBHOOK_URL=https://n8n.example.com/webhook/chat

# App
PORT=3000
LOG_LEVEL=info
